import math
import time

import rclpy
from geometry_msgs.msg import Twist
from ros_gz_interfaces.msg import Contacts
from std_msgs.msg import Bool

from ai_flight_alignment import AIFlightAlignment


class AIFinalLanding(AIFlightAlignment):

    def __init__(self):
        super().__init__()

        self.declare_parameter('descent_enabled', False)
        self.declare_parameter('shutdown_on_contact', False)

        self.descent_enabled = bool(
            self.get_parameter('descent_enabled').value
        )
        self.shutdown_on_contact = bool(
            self.get_parameter('shutdown_on_contact').value
        )

        self.phase = 'ALIGN'
        self.center_since = None
        self.ground_since = None
        self.last_ground_contact = 0.0
        self.contact_count = 0

        self.roll = 0.0
        self.pitch = 0.0

        # Landing pad location in ai_touchdown_test.sdf
        self.pad_xy = (0.40, 0.30)

        root = (
            '/world/first_flight/model/quadcopter/'
            'link/base_link/sensor'
        )

        for part in (
            'body_collision',
            'arm_1_collision',
            'arm_2_collision'
        ):
            self.create_subscription(
                Contacts,
                f'{root}/{part}_contact_sensor/contact',
                self.on_contact,
                10
            )

        self.get_logger().info(
            f'PRECISION LANDING | descent={self.descent_enabled} | '
            f'auto_motor_shutdown={self.shutdown_on_contact}'
        )

    def on_odometry(self, msg):
        super().on_odometry(msg)

        q = msg.pose.pose.orientation

        sinr = 2.0 * (q.w * q.x + q.y * q.z)
        cosr = 1.0 - 2.0 * (q.x*q.x + q.y*q.y)

        self.roll = math.atan2(sinr, cosr)

        sinp = 2.0 * (q.w*q.y - q.z*q.x)

        self.pitch = math.asin(
            max(-1.0, min(1.0, sinp))
        )

    def on_contact(self, msg):
        for contact in msg.contacts:

            a = contact.collision1.name
            b = contact.collision2.name

            ground_contact = (
                ('ground_plane' in a and 'quadcopter' in b)
                or
                ('ground_plane' in b and 'quadcopter' in a)
            )

            if ground_contact:
                self.last_ground_contact = time.monotonic()
                self.contact_count += 1
                return

    def update(self):
        now = time.monotonic()

        cmd = Twist()
        status = 'NO ODOMETRY - HOLD'

        odom_ok = (
            self.position is not None
            and now - self.last_odom < 1.0
        )

        if odom_ok:

            x, y, z = self.position
            sx, sy, _ = self.start_position

            near_pad = (
                math.hypot(
                    x - self.pad_xy[0],
                    y - self.pad_xy[1]
                ) < 0.18
            )

            fault = None

            if math.hypot(x - sx, y - sy) > getattr(self, 'max_movement_radius', 0.85):
                fault = 'MOVEMENT BOUNDARY'

            elif not 0.02 <= z <= 2.3:
                fault = 'ALTITUDE LIMIT'

            elif max(
                abs(self.roll),
                abs(self.pitch),
                abs(self.yaw)
            ) > math.radians(20):
                fault = 'ATTITUDE LIMIT'

            if fault:
                self.permanent_hold = True
                self.hold_reason = fault

            visual_ok = (
                self.target is not None
                and now - self.last_detection < 1.5
            )

            error_x = error_y = 0.0
            visual_error = float('inf')

            if visual_ok:

                cx, cy, _ = self.target

                error_x = cx - 0.5
                error_y = cy - 0.5

                visual_error = max(
                    abs(error_x),
                    abs(error_y)
                )

            if self.phase == 'TOUCHDOWN':

                if self.shutdown_on_contact:
                    status = 'CONTACT CONFIRMED - MOTORS OFF'
                else:
                    status = 'CONTACT CONFIRMED - MOTORS ON (TEST)'

            elif self.permanent_hold:

                status = f'SAFETY HOLD: {self.hold_reason}'

            elif not self.horizontal_enabled:

                status = 'HORIZONTAL DISABLED - HOLD'

            elif self.phase == 'ALIGN':

                cmd.linear.z = self.limit(
                    0.6 * (1.5 - z), 0.15
                )

                if self.alignment_start is None and visual_ok:
                    self.alignment_start = now

                if (
                    self.alignment_start is not None
                    and now - self.alignment_start > getattr(self, 'alignment_timeout', 15.0)
                ):
                    self.permanent_hold = True
                    self.hold_reason = 'ALIGNMENT TIMEOUT'
                    cmd = Twist()
                    status = 'SAFETY HOLD: ALIGNMENT TIMEOUT'

                elif not visual_ok:

                    self.center_since = None
                    status = 'NO DETECTION - HOVER'

                elif visual_error < 0.025:

                    if self.center_since is None:
                        self.center_since = now

                    status = 'ALIGNMENT VERIFYING'

                    if now - self.center_since >= 2.0:
                        self.phase = (
                            'APPROACH'
                            if self.descent_enabled
                            else 'ALIGNED'
                        )

                else:

                    self.center_since = None

                    cmd.linear.x = self.limit(
                        -0.6 * error_y, 0.12
                    )

                    cmd.linear.y = self.limit(
                        -0.6 * error_x, 0.12
                    )

                    status = 'VISION ALIGNING'

            elif self.phase == 'ALIGNED':

                status = 'ALIGNED - HOVER'

                cmd.linear.z = self.limit(
                    0.6 * (1.5 - z), 0.15
                )

            elif self.phase == 'APPROACH':

                if not visual_ok:

                    # Handoff only after visual alignment and approach.
                    # Use the known landing-pad position from odometry.
                    position_error = math.hypot(
                        x - self.pad_xy[0],
                        y - self.pad_xy[1]
                    )

                    if (
                        self.descent_enabled
                        and z <= 0.95
                        and position_error < 0.08
                    ):
                        self.phase = 'FINAL'
                        status = 'ODOMETRY LANDING HANDOFF'
                    else:
                        status = 'NO DETECTION - DESCENT STOPPED'

                else:

                    cmd.linear.x = self.limit(
                        -0.6 * error_y, 0.08
                    )

                    cmd.linear.y = self.limit(
                        -0.6 * error_x, 0.08
                    )

                    if visual_error < 0.04 and near_pad:

                        if z <= 0.85:

                            self.phase = 'FINAL'
                            cmd = Twist()
                            status = 'FINAL DESCENT LOCKED'

                        else:

                            cmd.linear.z = -0.06
                            status = 'VISION-GUIDED DESCENT'

                    else:

                        status = 'REALIGNING - DESCENT PAUSED'

            elif self.phase == 'FINAL':

                fresh_ground = (
                    now - self.last_ground_contact < 0.30
                )

                if fresh_ground and z < 0.15 and near_pad:

                    if self.ground_since is None:
                        self.ground_since = now

                else:

                    self.ground_since = None

                if (
                    self.ground_since is not None
                    and now - self.ground_since >= 0.5
                    and self.contact_count >= 3
                ):

                    self.phase = 'TOUCHDOWN'
                    status = 'CONTACT CONFIRMED - MOTORS ON (TEST)'

                elif z < 0.035:

                    self.permanent_hold = True
                    self.hold_reason = 'CONTACT NOT CONFIRMED'
                    status = 'SAFETY HOLD: CONTACT NOT CONFIRMED'

                elif not near_pad:

                    self.permanent_hold = True
                    self.hold_reason = 'PAD POSITION LOST'
                    status = 'SAFETY HOLD: PAD POSITION LOST'

                else:

                    cmd.linear.z = -0.035
                    status = 'FINAL SLOW DESCENT'

        self.preview_pub.publish(cmd)

        if self.flight_enabled:

            motors_off = (
                self.phase == 'TOUCHDOWN'
                and self.shutdown_on_contact
            )

            self.enable_pub.publish(
                Bool(data=not motors_off)
            )

            self.cmd_pub.publish(cmd)

        if now - self.last_log > 1.5:

            altitude = (
                f'{self.position[2]:.3f}'
                if odom_ok else 'N/A'
            )

            self.get_logger().info(
                f'{status} | z={altitude} | '
                f'vx={cmd.linear.x:.3f} '
                f'vy={cmd.linear.y:.3f} '
                f'vz={cmd.linear.z:.3f}'
            )

            self.last_log = now


def main():

    rclpy.init()
    node = AIFinalLanding()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:

        if rclpy.ok() and node.flight_enabled:
            node.cmd_pub.publish(Twist())
            time.sleep(0.2)

        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
